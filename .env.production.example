# =============================================================================
# Masraf Yonetim Sistemi — Production Ortam Degiskenleri
# Bu dosya Northflank Secret Group'a eklenecek degiskenlerin referansidir.
# Gercek degerler YALNIZCA Northflank Secret Group icerisinde tanimlanir.
# =============================================================================

NODE_ENV=production
APP_ENVIRONMENT=production

# ── Servis ────────────────────────────────────────────────────────────────────
PORT=4000
WEB_URL=https://app.example.invalid
API_URL=https://app.example.invalid
CORS_ORIGINS=https://app.example.invalid

# ── Release bilgisi ──────────────────────────────────────────────────────────
# Northflank build arguments veya CI pipeline tarafindan set edilir.
APP_VERSION=0.1.0
APP_COMMIT_SHA=abc1234
APP_BUILD_DATE=2026-01-01T00:00:00Z

# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Her iki URL de sslmode=require icermelidir.
# DATABASE_URL: pooler (PgBouncer transaction mode) — runtime API icin
# DIRECT_URL:   dogrudan baglanti — yalnizca prisma migrate deploy icin
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASS@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ── JWT Kimlik Dogrulama ──────────────────────────────────────────────────────
# Her biri en az 32 karakter, birbirinden FARKLI olmali.
# Olusturmak icin: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECRET=CHANGE_ME_MIN_32_CHARS
COOKIE_DOMAIN=.example.invalid

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
STORAGE_PROVIDER=s3
R2_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID
R2_ENDPOINT=https://YOUR_CF_ACCOUNT_ID.r2.cloudflarestorage.com
# Yalnızca imzalı URL tarayıcıdan farklı bir endpoint kullanacaksa tanımlanır.
R2_PUBLIC_ENDPOINT=
R2_REGION=auto
R2_BUCKET=masraf-attachments
# Northflank'te R2_BUCKET_NAME kullanılıyorsa aynı değer kabul edilir.
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_FORCE_PATH_STYLE=false
R2_SIGNED_URL_TTL_SECONDS=900
MAX_ATTACHMENTS_PER_EXPENSE=5
MAX_ATTACHMENT_SIZE_BYTES=15728640

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ── Loglama ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Swagger ───────────────────────────────────────────────────────────────────
ENABLE_SWAGGER=false

# ── Bakim Modu ────────────────────────────────────────────────────────────────
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Planli bakim calismasi devam ediyor.

# ── E-posta / SMTP (opsiyonel) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.invalid

# ── Hata izleme (opsiyonel) ───────────────────────────────────────────────────
SENTRY_DSN=

# ── Vite Build Arguments (docker-compose.production.yml / Northflank) ─────────
# Bu degiskenler build-time'da frontend'e gomulur, runtime'da kullanilmaz.
VITE_API_URL=/api/v1
VITE_APP_NAME=Masraf Uygulamasi
VITE_APP_ENVIRONMENT=production
# VITE_APP_VERSION build pipeline'dan otomatik gelir.
